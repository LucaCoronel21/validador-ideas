# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional: fija un modelo puntual en vez del alias "-latest" (útil si el
# alias apunta a un modelo nuevo con mucha demanda/inestable).
GEMINI_MODEL=gemini-flash-latest

# Busqueda web (competidores reales)
TAVILY_API_KEY=

# Orquestacion de jobs en background
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL publica de la app (usada por QStash para llamar de vuelta a los endpoints)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting (opcional, tienen default en el codigo)
# GLOBAL_DAILY_LIMIT: default 3. El free tier de Gemini permite 20
# requests/dia por modelo, y cada validacion gasta 5 (una por agente) -
# no subir mucho mas de 3 sin pasar a un tier de Gemini con mas cuota.
# GLOBAL_DAILY_LIMIT=3
# USER_DAILY_LIMIT=3
